{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": { "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "build.ts"] },
  "formatter": { "enabled": false },
  "organizeImports": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": { "noUndeclaredVariables": "error", "noUnusedImports": "error", "noUnreachable": "error", "noConstAssign": "error", "noInvalidUseBeforeDeclaration": "error" },
      "suspicious": { "noRedeclare": "error", "noDuplicateObjectKeys": "error", "noSelfCompare": "error", "noDoubleEquals": "off" }
    }
  },
  "javascript": { "globals": ["Bun"] }
}
